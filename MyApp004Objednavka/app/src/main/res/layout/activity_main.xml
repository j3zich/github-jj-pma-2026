<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurfaceVariant"
	android:gravity="center"
	android:orientation="vertical"
	android:padding="24dp"
	tools:context=".MainActivity"
	>

	<TextView
		android:id="@+id/tvHeaderTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/text_view_heading"
		android:textSize="24sp"
		android:textStyle="bold"
		/>

	<TextView
		android:id="@+id/tvOrderTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="16dp"
		android:text="@string/text_view_description"
		android:textSize="16sp"
		/>

	<RadioGroup
		android:id="@+id/rgTv"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:orientation="horizontal"
		>

		<RadioButton
			android:id="@+id/rb65"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:checked="true"
			android:text="@string/radio_button_65_inch"
			/>

		<RadioButton
			android:id="@+id/rb55"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/radio_button_55_inch"
			/>

		<RadioButton
			android:id="@+id/rb43"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/radio_button_43_inch"
			/>
	</RadioGroup>

	<CheckBox
		android:id="@+id/cbSpeakers"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:text="@string/check_box_speakers"
		/>

	<CheckBox
		android:id="@+id/cbPanel"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:text="@string/check_box_panel"
		/>

	<CheckBox
		android:id="@+id/cbStand"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:text="@string/check_box_stand"
		/>

	<Button
		android:id="@+id/btnOrder"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:text="@string/button_make_order_text"
		/>

	<TextView
		android:id="@+id/tvOrder"
		android:layout_width="match_parent"
		android:layout_height="100dp"
		android:layout_marginTop="20dp"
		android:background="#FFF59D"
		android:padding="16dp"
		android:text="@string/textview_order_summary_placeholder"
		android:textColor="@color/black"
		/>

	<ImageView
		android:id="@+id/ivTV"
		android:layout_width="match_parent"
		android:layout_height="200dp"
		android:layout_marginTop="20dp"
		android:background="@color/white"
		android:padding="10sp"
		android:src="@drawable/tv_65"
		/>
</LinearLayout>
